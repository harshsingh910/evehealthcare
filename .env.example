# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://eve_user:eve_password@localhost:5432/eve_healthcare
TEST_DATABASE_URL=postgresql://eve_user:eve_password@localhost:5432/eve_healthcare_test

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-to-a-real-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Cache
CACHE_TTL_SECONDS=300

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Server
PORT=8000
